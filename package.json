{
  "name": "emmylua-extends",
  "displayName": "EmmyLua Extends",
  "description": "EmmyLua 语言服务的实用增强",
  "version": "0.0.6",
  "publisher": "robota",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:lua"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "emmyluaExtends.gotoSourceDefinition",
        "title": "Lua: 转到源文件定义",
        "category": "EmmyLua Extends"
      }
    ],
    "keybindings": [
      {
        "command": "emmyluaExtends.gotoSourceDefinition",
        "key": "f12",
        "when": "editorTextFocus && editorLangId == lua"
      }
    ]
  }
}
