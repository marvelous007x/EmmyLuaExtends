{
  "name": "emmylua-extends",
  "displayName": "EmmyLua Extends",
  "description": "EmmyLua 语言服务的实用增强",
  "version": "0.0.3",
  "publisher": "robota",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:lua"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "emmyluaExtends.gotoSourceDefinition",
        "title": "Lua: 转到源文件定义",
        "category": "EmmyLua Extends"
      }
    ],
    "keybindings": [
      {
        "command": "emmyluaExtends.gotoSourceDefinition",
        "key": "f12",
        "when": "editorTextFocus && editorLangId == lua"
      }
    ],
    "configuration": {
      "title": "EmmyLua Extends",
      "properties": {
        "emmyluaExtends.metaDirName": {
          "type": "string",
          "default": "_meta",
          "description": "meta 注解目录名。该目录下的文件会把定义跳转映射到 --source: 标注的源文件。"
        }
      }
    }
  }
}
